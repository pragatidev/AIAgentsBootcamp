# Copy to .env. Never commit .env.
# Labs call get_chat_model() from config.py. Change provider here, not in a notebook.

# Local (no key). Student default chat model is qwen3:8b.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_NO_TOOLS_MODEL=llama3.2:3b

# Hosted. Leave blank until you have a key. Then set the matching model id.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=

# Notebooks that still call get_llm() from src/llm.py
PREFERRED_PROVIDER=ollama
OLLAMA_DEFAULT_MODEL=qwen3:8b
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBED_MODEL=nomic-embed-text
