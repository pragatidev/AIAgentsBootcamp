# AI Agents Bootcamp — environment
#
# 1. Copy this file to .env in THIS folder (the repo root).
#      Windows:    copy .env.sample .env
#      macOS/Linux: cp .env.sample .env
# 2. Fill ONE provider. Leave the others blank.
# 3. Never commit .env. Never paste a key into a notebook.
#
# Notebooks call get_llm() / get_autogen_config() from src/llm.py.
# Change PREFERRED_PROVIDER here. Do not edit the notebook to change models.

PREFERRED_PROVIDER=ollama
# ollama     local, no key, default for learning
# anthropic  Claude. Set ANTHROPIC_API_KEY (or LLM_API_KEY)
# openai     GPT. Set OPENAI_API_KEY
# auto       first key it finds, else Ollama

# --- Local (no key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_BACKEND=
LLM_BASE_URL=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# --- RAG embeddings (local, no OpenAI embed key) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
